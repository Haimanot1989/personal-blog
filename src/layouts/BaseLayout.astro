---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  publishedDate?: Date;
  noindex?: boolean;
}

const { title, description, publishedDate, noindex = false } = Astro.props;
const pageTitle = `${title} | Haimanot`;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="nb">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Haimanot" />
    {noindex ? <meta name="robots" content="noindex, follow" /> : <link rel="canonical" href={canonical} />}
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={publishedDate ? 'article' : 'website'} />
    <meta property="og:site_name" content="Haimanot" />
    <meta property="og:locale" content="nb_NO" />
    {!noindex && <meta property="og:url" content={canonical} />}
    {publishedDate && <meta property="article:published_time" content={publishedDate.toISOString()} />}
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <a class="skip-link" href="#main">Hopp til innhold</a>
    <header class="site-header">
      <a class="site-name" href="/">Haimanot<span class="domain">.dev</span></a>
      <nav aria-label="Hovedmeny">
        <a href="/" aria-current={Astro.url.pathname === '/' ? 'page' : undefined}>Blogg</a>
      </nav>
    </header>
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <footer class="site-footer">
      <p>Haimanots personlige blogg. Ingen sporing eller informasjonskapsler.</p>
    </footer>
  </body>
</html>
