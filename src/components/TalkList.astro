---
import type { CollectionEntry } from 'astro:content';
import { languages, talkPath, topicPath, type Locale } from '../i18n';
import { formatDate } from '../lib/blog';

interface Props {
  locale: Locale;
  talks: CollectionEntry<'talks'>[];
  headingLevel?: 'h2' | 'h3';
}

const { locale, talks, headingLevel: Heading = 'h2' } = Astro.props;
const messages = languages[locale].messages;
---

{talks.length === 0 ? <p>{messages.emptyTalks}</p> : (
  <ul class="post-list">
    {talks.map((talk) => (
      <li>
        <article>
          <time datetime={talk.data.publishedDate.toISOString().slice(0, 10)}>
            {formatDate(talk.data.publishedDate, locale)}
          </time>
          <Heading><a href={talkPath(locale, talk.data.slug)}>{talk.data.title}</a></Heading>
          <p>{talk.data.description}</p>
          <a href={topicPath(locale, talk.data.topic)}>{messages.topicNames[talk.data.topic]}</a>
        </article>
      </li>
    ))}
  </ul>
)}
