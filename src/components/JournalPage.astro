---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { languages, sectionAlternates, sectionPath, supportedLocales, tagPath, topicPath, type Locale, type Section } from '../i18n';
import type { Topic } from '../lib/taxonomy';
import PostList from './PostList.astro';
import TopicList from './TopicList.astro';
import TalkList from './TalkList.astro';
import TagCloud from './TagCloud.astro';

interface Props {
  locale: Locale;
  section: Section;
  topic?: Topic;
  tag?: string;
  posts: CollectionEntry<'blog'>[];
  talks: CollectionEntry<'talks'>[];
}

const { locale, section, topic, tag, posts, talks } = Astro.props;
const messages = languages[locale].messages;
const title = tag ? `${messages.tagsLabel}: ${tag}` : topic ? messages.topicNames[topic] : messages[section];
const descriptions = {
  writing: messages.writingDescription,
  topics: messages.topicsDescription,
  talks: messages.talksDescription,
  about: messages.aboutDescription,
};
const description = tag ? messages.tagDescription : topic ? messages.topicDescriptions[topic] : descriptions[section];
const alternates = tag
  ? supportedLocales.map((target) => ({ locale: target, href: tagPath(target, tag) }))
  : topic
  ? supportedLocales.map((target) => ({ locale: target, href: topicPath(target, topic) }))
  : sectionAlternates(section);
const tags = [...new Set(posts.flatMap((post) => post.data.tags))].sort((a, b) => a.localeCompare(b, 'en'));
---

<BaseLayout locale={locale} title={title} description={description} alternates={alternates}>
  <section class="intro" aria-labelledby="page-title" data-pagefind-body={section === 'about' ? '' : undefined}>
    {tag && <a class="back-link" href={sectionPath(locale, 'writing')}>{messages.backToPosts}</a>}
    <h1 id="page-title" data-pagefind-meta={section === 'about' ? 'title' : undefined}>{title}</h1>
    <p>{description}</p>
  </section>
  {section === 'writing' && !tag && tags.length > 0 && (
    <section class="browse-tags" aria-labelledby="tags-title">
      <h2 id="tags-title">{messages.browseTags}</h2>
      <TagCloud locale={locale} tags={tags} />
    </section>
  )}
  {(section === 'writing' || topic) && (
    <section aria-labelledby="writing-title">
      <h2 id="writing-title">{messages.writing}</h2>
      <PostList locale={locale} posts={posts} />
    </section>
  )}
  {section === 'topics' && !topic && <TopicList locale={locale} posts={posts} />}
  {section === 'about' && (
    <div class="prose" data-pagefind-body>{messages.aboutParagraphs.map((paragraph) => <p>{paragraph}</p>)}</div>
  )}
  {section === 'talks' && <TalkList locale={locale} talks={talks} />}
  {topic && talks.length > 0 && (
    <section class="topic-section" aria-labelledby="talks-title">
      <h2 id="talks-title">{messages.talks}</h2>
      <TalkList locale={locale} talks={talks} headingLevel="h3" />
    </section>
  )}
</BaseLayout>
