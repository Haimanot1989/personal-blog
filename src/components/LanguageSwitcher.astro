---
import { homePath, languages, supportedLocales, type Alternate, type Locale } from '../i18n';

interface Props {
  locale: Locale;
  alternates: Alternate[];
}

const { locale, alternates } = Astro.props;
const messages = languages[locale].messages;
---

<nav class="language-switcher" aria-label={messages.languageNavigation}>
  <ul>
    {supportedLocales.map((targetLocale) => {
      const language = languages[targetLocale];
      const alternate = alternates.find((item) => item.locale === targetLocale);
      const missing = alternate === undefined;
      return (
        <li>
          <a
            href={alternate?.href ?? homePath(targetLocale)}
            hreflang={targetLocale}
            aria-current={locale === targetLocale ? 'page' : undefined}
          >
            <span lang={targetLocale}>
              <span aria-hidden="true">{language.flag}</span> {language.name}
            </span>
            {missing && <span class="translation-notice">{messages.missingTranslation}</span>}
          </a>
        </li>
      );
    })}
  </ul>
</nav>
