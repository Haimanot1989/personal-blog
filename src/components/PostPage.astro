---
import { render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { homePath, languages, type Alternate } from '../i18n';
import { formatDate } from '../lib/blog';

interface Props {
  post: CollectionEntry<'blog'>;
  alternates: Alternate[];
}

const { post, alternates } = Astro.props;
const locale = post.data.language;
const messages = languages[locale].messages;
const { Content } = await render(post);
---

<BaseLayout
  locale={locale}
  alternates={alternates}
  title={post.data.title}
  description={post.data.description}
  publishedDate={post.data.publishedDate}
>
  <article>
    <header class="post-header">
      <a class="back-link" href={homePath(locale)}>{messages.backToPosts}</a>
      <h1>{post.data.title}</h1>
      <p class="post-description">{post.data.description}</p>
      <time datetime={post.data.publishedDate.toISOString().slice(0, 10)}>
        {formatDate(post.data.publishedDate, locale)}
      </time>
    </header>
    <div class="prose"><Content /></div>
  </article>
</BaseLayout>
