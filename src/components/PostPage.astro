---
import { render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { languages, sectionPath, type Alternate } from '../i18n';
import { formatDate } from '../lib/blog';
import PostLabels from './PostLabels.astro';

interface Props {
  post: CollectionEntry<'blog'>;
  alternates: Alternate[];
}

const { post, alternates } = Astro.props;
const locale = post.data.language;
const messages = languages[locale].messages;
const { Content } = await render(post);
---

<BaseLayout
  locale={locale}
  alternates={alternates}
  title={post.data.title}
  description={post.data.description}
  publishedDate={post.data.publishedDate}
>
  <article>
    <header class="post-header">
      <a class="back-link" href={sectionPath(locale, 'writing')}>{messages.backToPosts}</a>
      <h1>{post.data.title}</h1>
      <p class="post-description">{post.data.description}</p>
      <time datetime={post.data.publishedDate.toISOString().slice(0, 10)}>
        {formatDate(post.data.publishedDate, locale)}
      </time>
      <PostLabels post={post} />
    </header>
    <div class="prose"><Content /></div>
    {post.data.sources.length > 0 && (
      <section class="sources" aria-labelledby="sources-title">
        <h2 id="sources-title">{messages.sources}</h2>
        <ul>
          {post.data.sources.map((source) => (
            <li>
              {source.url ? <a href={source.url}>{source.title}</a> : <cite>{source.title}</cite>}
              {' — '}{messages.sourceTypeNames[source.type]}
              {source.author && ` · ${source.author}`}
              {source.locator && ` · ${source.locator}`}
            </li>
          ))}
        </ul>
      </section>
    )}
  </article>
</BaseLayout>
