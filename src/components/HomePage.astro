---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { languages, sectionPath, type Locale } from '../i18n';
import PostList from './PostList.astro';
import TopicList from './TopicList.astro';

interface Props {
  locale: Locale;
  posts: CollectionEntry<'blog'>[];
}

const { locale, posts } = Astro.props;
const messages = languages[locale].messages;
---

<BaseLayout locale={locale} title={messages.homeTitle} description={messages.homeDescription}>
  <section class="intro" aria-labelledby="page-title">
    <p class="eyebrow">{messages.eyebrow}</p>
    <h1 id="page-title">{messages.greeting}</h1>
    <p>{messages.introduction}</p>
  </section>
  <section aria-labelledby="posts-title">
    <h2 id="posts-title">{messages.latestPosts}</h2>
    <PostList locale={locale} posts={posts.slice(0, 5)} />
    <p class="section-link"><a href={sectionPath(locale, 'writing')}>{messages.viewAllWriting}</a></p>
  </section>
  <section class="topic-section" aria-labelledby="topics-title">
    <h2 id="topics-title">{messages.browseTopics}</h2>
    <TopicList locale={locale} posts={posts} />
  </section>
</BaseLayout>
