---
import BaseLayout from '../layouts/BaseLayout.astro';
import { defaultLocale, homePath, languages, supportedLocales } from '../i18n';
const messages = languages[defaultLocale].messages;
---

<BaseLayout title={messages.notFoundTitle} description={messages.notFoundDescription} noindex>
  <p class="eyebrow">404</p>
  <h1>{messages.notFoundTitle}</h1>
  {supportedLocales.map((locale) => {
    const text = languages[locale].messages;
    return (
      <section lang={locale} aria-label={text.notFoundTitle} class="error-language">
        {locale !== defaultLocale && <h2>{text.notFoundTitle}</h2>}
        <p>{text.notFoundMessage}</p>
        <p><a href={homePath(locale)}>{text.goHome}</a></p>
      </section>
    );
  })}
</BaseLayout>
