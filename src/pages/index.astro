---
import BaseLayout from '../layouts/BaseLayout.astro';
import { formatDate, getPublishedPosts } from '../lib/blog';

const posts = await getPublishedPosts();
---

<BaseLayout title="Personlig blogg" description="Haimanots personlige blogg om kode, teknologi og det jeg lærer underveis.">
  <section class="intro" aria-labelledby="page-title">
    <p class="eyebrow">Notater fra hverdagen</p>
    <h1 id="page-title">Hei, jeg er Haimanot.</h1>
    <p>Her skriver jeg om kode, teknologi og det jeg lærer underveis.</p>
  </section>
  <section aria-labelledby="posts-title">
    <h2 id="posts-title">Siste innlegg</h2>
    {
      posts.length === 0 ? (
        <p>Det er ingen publiserte innlegg ennå.</p>
      ) : (
        <ul class="post-list">
          {posts.map((post) => (
            <li>
              <article>
                <time datetime={post.data.publishedDate.toISOString().slice(0, 10)}>
                  {formatDate(post.data.publishedDate)}
                </time>
                <h3><a href={`/blog/${post.data.slug}/`}>{post.data.title}</a></h3>
                <p>{post.data.description}</p>
              </article>
            </li>
          ))}
        </ul>
      )
    }
  </section>
</BaseLayout>
