---
import type { CollectionEntry } from 'astro:content';
import HomePage from '../components/HomePage.astro';
import PostPage from '../components/PostPage.astro';
import JournalPage from '../components/JournalPage.astro';
import TalkPage from '../components/TalkPage.astro';
import SearchPage from '../components/SearchPage.astro';
import { homePath, postPath, searchPath, sectionPath, sections, supportedLocales, tagPath, talkPath, topicPath, type Alternate, type Locale, type Section } from '../i18n';
import { getPostAlternates, getPublishedPosts, getPublishedTalks, getTalkAlternates } from '../lib/blog';
import { topics, type Topic } from '../lib/taxonomy';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  const talks = await getPublishedTalks();
  const tags = [...new Set(posts.flatMap((post) => post.data.tags))].sort((a, b) => a.localeCompare(b, 'en'));
  return [
    ...supportedLocales.map((locale) => ({
      params: { path: homePath(locale).slice(1, -1) || undefined },
      props: { kind: 'home' as const, locale, posts: posts.filter((post) => post.data.language === locale) },
    })),
    ...supportedLocales.map((locale) => ({
      params: { path: searchPath(locale).slice(1, -1) },
      props: { kind: 'search' as const, locale },
    })),
    ...posts.map((post) => ({
      params: { path: postPath(post.data.language, post.data.slug).slice(1, -1) },
      props: { kind: 'post' as const, post, alternates: getPostAlternates(post, posts) },
    })),
    ...supportedLocales.flatMap((locale) => [
      ...sections.map((section) => ({
        params: { path: sectionPath(locale, section).slice(1, -1) },
        props: {
          kind: 'journal' as const, locale, section,
          posts: posts.filter((post) => post.data.language === locale),
          talks: talks.filter((talk) => talk.data.language === locale),
        },
      })),
      ...topics.map((topic) => ({
        params: { path: topicPath(locale, topic).slice(1, -1) },
        props: {
          kind: 'journal' as const, locale, section: 'topics' as const, topic,
          posts: posts.filter((post) => post.data.language === locale && post.data.topic === topic),
          talks: talks.filter((talk) => talk.data.language === locale && talk.data.topic === topic),
        },
      })),
      ...tags.map((tag) => ({
        params: { path: tagPath(locale, tag).slice(1, -1) },
        props: {
          kind: 'journal' as const, locale, section: 'writing' as const, tag,
          posts: posts.filter((post) => post.data.language === locale && post.data.tags.includes(tag)),
          talks: [],
        },
      })),
    ]),
    ...talks.map((talk) => ({
      params: { path: talkPath(talk.data.language, talk.data.slug).slice(1, -1) },
      props: { kind: 'talk' as const, talk, alternates: getTalkAlternates(talk, talks), posts },
    })),
  ];
}

type Props =
  | { kind: 'home'; locale: Locale; posts: CollectionEntry<'blog'>[] }
  | { kind: 'search'; locale: Locale }
  | { kind: 'post'; post: CollectionEntry<'blog'>; alternates: Alternate[] }
  | { kind: 'journal'; locale: Locale; section: Section; topic?: Topic; tag?: string; posts: CollectionEntry<'blog'>[]; talks: CollectionEntry<'talks'>[] }
  | { kind: 'talk'; talk: CollectionEntry<'talks'>; alternates: Alternate[]; posts: CollectionEntry<'blog'>[] };

const props = Astro.props;
---

{props.kind === 'home' ? (
  <HomePage locale={props.locale} posts={props.posts} />
) : props.kind === 'search' ? (
  <SearchPage locale={props.locale} />
) : props.kind === 'post' ? (
  <PostPage post={props.post} alternates={props.alternates} />
) : props.kind === 'journal' ? (
  <JournalPage
    locale={props.locale}
    section={props.section}
    posts={props.posts}
    talks={props.talks}
    {...(props.topic ? { topic: props.topic } : {})}
    {...(props.tag ? { tag: props.tag } : {})}
  />
) : (
  <TalkPage talk={props.talk} alternates={props.alternates} posts={props.posts} />
)}
